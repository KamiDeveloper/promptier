# ─── Neon Serverless Postgres ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ─── Neon Auth (Better Auth) ───────────────────────────────────────────────
# Get these from: Neon Console → Your Project → Auth tab
# Google OAuth is configured in the Neon Console (no GOOGLE_CLIENT_* needed here)
NEON_AUTH_BASE_URL=https://your-project.auth.us-east-1.aws.neon.tech
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Public: Neon Auth URL (used by browser client — safe to be public)
NEXT_PUBLIC_NEON_AUTH_BASE_URL=https://your-project.auth.us-east-1.aws.neon.tech

# Public: Your deployed app URL (used for auth callbacks)
# In development: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Gemini AI (server-side ONLY — never prefix with NEXT_PUBLIC_) ─────────
GEMINI_SHARED_API_KEY=
# Legacy fallback for existing local setups. Prefer GEMINI_SHARED_API_KEY going forward.
GEMINI_API_KEY=

# BYOK encryption. Generate each key with: openssl rand -base64 32
BYOK_ENCRYPTION_KEY=
BYOK_FINGERPRINT_KEY=
BYOK_ENCRYPTION_KID=v1
